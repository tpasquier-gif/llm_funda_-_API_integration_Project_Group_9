# Copy this file to .env (which is never committed) and fill it in.
# Each member uses their own key: it is personal and has a spending limit.

ANTHROPIC_API_KEY=

# Optional back-up key, used only by the live demo (python -m src.ask) when the key above has no
# credit left or has expired. An Anthropic key (sk-ant-...) or an OpenRouter key (sk-or-...).
ANTHROPIC_API_KEY_FALLBACK=
